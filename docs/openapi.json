  "components": {
    "schemas": {
      "CorrectionInput": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Event Id"
          },
          "original_id": {
            "type": "string",
            "format": "uuid",
            "title": "Original Id"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity",
            "decimal_places": 6,
            "gt": 0,
            "le": 1000000000,
            "max_digits": 16
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "original_id",
          "quantity",
          "reason"
        ],
        "title": "CorrectionInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssueInput": {
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^20\\d{2}-(0[1-9]|1[0-2])$",
            "title": "Period"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "period"
        ],
        "title": "IssueInput"
      },
      "RateInput": {
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "api_calls",
              "storage_gb_hours",
              "compute_seconds"
            ],
            "title": "Metric"
          },
          "unit_price": {
            "type": "string",
            "title": "Unit Price",
            "decimal_places": 8,
            "gt": 0,
            "le": 1000000,
            "max_digits": 15
          },
          "effective_at": {
            "type": "string",
            "format": "date-time",
            "title": "Effective At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "unit_price",
          "effective_at"
        ],
        "title": "RateInput"
      },
      "TenantInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "TenantInput"
      },
      "UsageInput": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Event Id"
          },
          "metric": {
            "type": "string",
            "enum": [
              "api_calls",
              "storage_gb_hours",
              "compute_seconds"
            ],
            "title": "Metric"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity",
            "decimal_places": 6,
            "gt": 0,
            "le": 1000000000,
            "max_digits": 16
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "metric",
          "quantity",
          "occurred_at"
        ],
        "title": "UsageInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "AdministratorKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token"
      },
      "CustomerKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
